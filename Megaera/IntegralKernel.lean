import Megaera.SplitKernel

/-! # The integral kernel of L

An integer combination is represented by addition and subtraction of
generators. `Derives r x y` is the congruence generated by the laws of
abelian groups and the displayed relations `r`. Taking `r = noRules` gives
the free abelian group. The kernel theorem below compares the actual two
presentations, using the potential of `SplitKernel` in the quotient.
-/

namespace Megaera.IntegralKernel
open Megaera.SplitKernel

private theorem congrArg₂ (f : A → B → C) {a b : A} {c d : B}
    (h : a = b) (k : c = d) : f a c = f b d := by cases h; cases k; rfl

inductive Word (A : Type)
  | zero | atom (a : A) | plus (x y : Word A) | minus (x y : Word A)

inductive Derives {A : Type} (r : Word A → Word A → Prop) : Word A → Word A → Prop
  | refl (x) : Derives r x x
  | symm : Derives r x y → Derives r y x
  | trans : Derives r x y → Derives r y z → Derives r x z
  | plus : Derives r x x' → Derives r y y' → Derives r (.plus x y) (.plus x' y')
  | minus : Derives r x x' → Derives r y y' → Derives r (.minus x y) (.minus x' y')
  | assoc (a b c) : Derives r (.plus (.plus a b) c) (.plus a (.plus b c))
  | comm (a b) : Derives r (.plus a b) (.plus b a)
  | addZero (a) : Derives r (.plus a .zero) a
  | subAdd (a b) : Derives r (.plus (.minus a b) b) a
  | addSub (a b) : Derives r (.minus (.plus a b) b) a
  | collect (a b c d) : Derives r (.plus (.minus a b) (.minus c d)) (.minus (.plus a c) (.plus b d))
  | rule : r x y → Derives r x y

def noRules {A : Type} : Word A → Word A → Prop := fun _ _ => False

def presentation {A : Type} (r : Word A → Word A → Prop) : Setoid (Word A) where
  r := Derives r
  iseqv := ⟨.refl, .symm, .trans⟩

abbrev Presented {A : Type} (r : Word A → Word A → Prop) := Quotient (presentation r)

def cls {A : Type} (r : Word A → Word A → Prop) (s : Word A) : Presented r :=
  Quotient.mk (presentation r) s

instance {r : Word A → Word A → Prop} : Zero (Presented r) := ⟨cls r .zero⟩
instance {r : Word A → Word A → Prop} : Add (Presented r) where
  add := Quotient.lift₂ (fun x y => cls r (.plus x y))
    (fun _ _ _ _ h k => Quotient.sound (Derives.plus h k))
instance {r : Word A → Word A → Prop} : Sub (Presented r) where
  sub := Quotient.lift₂ (fun x y => cls r (.minus x y))
    (fun _ _ _ _ h k => Quotient.sound (Derives.minus h k))

variable {r : Word A → Word A → Prop}
instance : Std.Associative (α := Presented r) (· + ·) where
  assoc x y z := Quotient.inductionOn₃ x y z fun a b c =>
    Quotient.sound (Derives.assoc (r := r) a b c)
instance : Std.Commutative (α := Presented r) (· + ·) where
  comm x y := Quotient.inductionOn₂ x y fun a b => Quotient.sound (Derives.comm (r := r) a b)

theorem addZero (a : Presented r) : a + 0 = a :=
  Quotient.inductionOn a fun a => Quotient.sound (Derives.addZero (r := r) a)

theorem laws (r : Word A → Word A → Prop) : Subtraction (Presented r) := by
  constructor
  · intro x y
    exact Quotient.inductionOn₂ x y fun a b => Quotient.sound (Derives.subAdd (r := r) a b)
  · intro x y
    exact Quotient.inductionOn₂ x y fun a b => Quotient.sound (Derives.addSub (r := r) a b)
  · intro w x y z
    induction w using Quotient.ind
    induction x using Quotient.ind
    induction y using Quotient.ind
    induction z using Quotient.ind
    exact Quotient.sound (Derives.collect (r := r) _ _ _ _)

def eval [Zero V] [Add V] [Sub V] (f : A → V) : Word A → V
  | .zero => 0
  | .atom a => f a
  | .plus x y => eval f x + eval f y
  | .minus x y => eval f x - eval f y

theorem eval_cls (r : Word A → Word A → Prop) (x : Word A) :
    eval (fun a => cls r (.atom a)) x = cls r x := by
  induction x with
  | zero => rfl
  | atom => rfl
  | plus x y hx hy => change eval _ x + eval _ y = _; rw [hx,hy]; rfl
  | minus x y hx hy => change eval _ x - eval _ y = _; rw [hx,hy]; rfl

theorem sound [Zero V] [Add V] [Sub V] [Std.Associative (α := V) (· + ·)]
    [Std.Commutative (α := V) (· + ·)] (zeroRight : ∀ a : V, a + 0 = a)
    (subLaws : Subtraction V) (f : A → V)
    (h : ∀ x y, r x y → eval f x = eval f y)
    {x y : Word A} (d : Derives r x y) : eval f x = eval f y := by
  induction d with
  | refl => rfl
  | symm _ ih => exact ih.symm
  | trans _ _ h₁ h₂ => exact h₁.trans h₂
  | plus _ _ h₁ h₂ => exact congrArg₂ (· + ·) h₁ h₂
  | minus _ _ h₁ h₂ => exact congrArg₂ (· - ·) h₁ h₂
  | assoc => exact Std.Associative.assoc ..
  | comm => exact Std.Commutative.comm ..
  | addZero => exact zeroRight _
  | subAdd => exact subLaws.sub_add ..
  | addSub => exact subLaws.add_sub ..
  | collect => exact subLaws.collect ..
  | rule hr => exact h _ _ hr

abbrev Mark := Tuple × Tuple
private def markWord (h t : Tuple) : Word Mark := .atom (h,t)

inductive localRules (q : Nat) : Word Mark → Word Mark → Prop
  | square (p m t : Tuple) (r c : Nat) (hp : Valid p) (hm : Valid m) (ht : Valid t)
      (hr : 0 < r) (hc : 0 < c) : localRules q
      (.plus (markWord p (r :: (m ++ (q+c)::t))) (markWord p (r :: (m ++ q::c::t))))
      (.plus (markWord (p ++ (q+r)::m) (c::t)) (markWord (p ++ q::r::m) (c::t)))
  | triangle (p m : Tuple) (r : Nat) (hp : Valid p) (hm : Valid m) (hr : 0 < r) :
      localRules q (markWord p (r :: (m ++ [q])))
      (.plus (markWord (p ++ (q+r)::m) []) (markWord (p ++ q::r::m) []))

def image (q : Nat) : Word Mark → Word Tuple
  | .zero => .zero
  | .atom (h,[]) => .atom (h++[q])
  | .atom (h,c::t) => .plus (.atom (h ++ (q+c)::t)) (.atom (h ++ q::c::t))
  | .plus x y => .plus (image q x) (image q y)
  | .minus x y => .minus (image q x) (image q y)

def admissible : Word Mark → Prop
  | .zero => True
  | .atom (h,t) => Valid h ∧ Valid t
  | .plus x y | .minus x y => admissible x ∧ admissible y

private theorem eval_image [Add V] [Sub V] [Zero V] (q : Nat) (f : Tuple → V)
    (g : Mark → V) (agree : ∀ h t, Valid h → Valid t → onRow q f h t = g (h,t))
    (x : Word Mark) (hx : admissible x) : eval f (image q x) = eval g x := by
  induction x with
  | zero => rfl
  | atom a =>
    obtain ⟨h,t⟩ := a
    cases t <;> exact agree _ _ hx.1 hx.2
  | plus x y ix iy => exact congrArg₂ (· + ·) (ix hx.1) (iy hx.2)
  | minus x y ix iy => exact congrArg₂ (· - ·) (ix hx.1) (iy hx.2)

private theorem cls_compatible (q : Nat) : Compatible q
    (fun h t => cls (localRules q) (markWord h t)) where
  square p m t r c hp hm ht hr hc := Quotient.sound
    (Derives.rule (localRules.square (q := q) p m t r c hp hm ht hr hc))
  triangle p m r hp hm hr := Quotient.sound
    (Derives.rule (localRules.triangle (q := q) p m r hp hm hr))

/-- If two integral row expressions have the same L-image as formal tuple
combinations, then the concrete squares and terminal triangles derive their
equality. This is the spanning direction, without a linear separation axiom. -/
theorem kernel_spanned (q : Nat) (hq : 0 < q) (x y : Word Mark)
    (hx : admissible x) (hy : admissible y)
    (ker : Derives noRules (image q x) (image q y)) : Derives (localRules q) x y := by
  let R := localRules q
  let g := fun p : Mark => cls R (.atom p)
  obtain ⟨f,hf⟩ := (compatible_iff (laws R) q hq (fun h t => g (h,t))).mp (cls_compatible q)
  have e := sound addZero (laws R) f (fun _ _ (v : False) => v.elim) ker
  rw [eval_image q f g hf x hx, eval_image q f g hf y hy] at e
  exact Quotient.exact ((eval_cls R x).symm.trans (e.trans (eval_cls R y)))

/-- The local generators lie in the kernel, as formal signed sums. -/
theorem kernel_sound (q : Nat) (x y : Word Mark)
    (hx : admissible x) (hy : admissible y)
    (h : Derives (localRules q) x y) : Derives noRules (image q x) (image q y) := by
  let R := noRules (A := Tuple)
  let f := fun t => cls R (.atom t)
  let g := fun p : Mark => onRow q f p.1 p.2
  have hc := onRow_compatible q f
  have respects : ∀ s t, localRules q s t → eval g s = eval g t := by
    intro s t rel
    cases rel with
    | square p m t r c hp hm ht hr hc' => exact hc.square p m t r c hp hm ht hr hc'
    | triangle p m r hp hm hr => exact hc.triangle p m r hp hm hr
  have e := sound addZero (laws R) g respects h
  have ok : ∀ p t, Valid p → Valid t → onRow q f p t = g (p,t) := by intros; rfl
  rw [← eval_image q f g ok x hx, ← eval_image q f g ok y hy] at e
  exact Quotient.exact ((eval_cls R (image q x)).symm.trans (e.trans (eval_cls R (image q y))))

theorem integral_kernel_iff (q : Nat) (hq : 0 < q) (x y : Word Mark)
    (hx : admissible x) (hy : admissible y) :
    Derives noRules (image q x) (image q y) ↔ Derives (localRules q) x y :=
  ⟨kernel_spanned q hq x y hx hy, kernel_sound q x y hx hy⟩

end Megaera.IntegralKernel
